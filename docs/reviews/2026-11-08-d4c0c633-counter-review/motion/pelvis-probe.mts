 return{id,pelvis,lean,rigErrors:validateRig(r),allPointsValid:frames.every(hasAll),maxBoneErrorPx:Math.max(...bones.map(([a,b])=>Math.abs(l(rest,a,b)-l(f,a,b)))),torsoErrorPx:Math.abs(torso(f)-torso(rest)),sourceQa:{fails:q.fails,warnings:q.warnings,adherence:q.adherence},gripPx,rig:r,before:judge(before),after:judge(after),...(extra?{corrected:judge(extra)}:{})};
