// Offline body qualification; downloads only public frame URLs already returned in the saved receipt.
import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {decodePngBytes,encodePngBytes} from '../../../app/src/lib/image/pngraw.ts';
import {contactSheet} from '../../../app/src/lib/items/items.ts';
import {padImg} from '../../../app/src/lib/items/items.ts';
import {bodyComponents,borderPx,paletteFit} from '../../../app/src/lib/rig/clips.ts';
const root=path.resolve(import.meta.dirname,'../../..'),out=path.join(root,'spikes/api/out/workflow-reconciliation-2026-11-01'),evidence=JSON.parse(fs.readFileSync(path.join(out,'body-evidence.json'),'utf8'));
const library=JSON.parse(fs.readFileSync(path.join(root,'app/dev-fixtures/motion-lab/library.json'),'utf8')),fixture=library.fixtures.find((f:any)=>f.id==='c27man');
const cases:any[]=[];
for(const row of evidence.rawEvidence.records){if(row.job.state!=='done'||row.images.length!==8)throw new Error('Raw control is incomplete');const variant=row.document.fixture.depthReference?'native-depth':'source-proxy',direction=row.document.direction,images=await Promise.all(row.images.map((i:any)=>decodePngBytes(Buffer.from(i.png,'base64'))));cases.push({variant,direction,images,durations:row.document.durations,jobId:row.job.id,requestHash:row.job.requestHash,document:row.document});}
for(const animation of evidence.pilot.character.animations)for(const direction of animation.directions){if(direction.frames.length!==8)throw new Error('Managed control is incomplete');const folder=path.join(out,'managed',direction.direction);fs.mkdirSync(folder,{recursive:true});
  const images=await Promise.all(direction.frames.map(async(url:string,i:number)=>{if(!url.startsWith('https://backblaze.pixellab.ai/'))throw new Error('Unexpected asset origin');const file=path.join(folder,`${i}.png`);if(!fs.existsSync(file)){const response=await fetch(url);if(!response.ok)throw new Error('Frame download failed '+response.status);fs.writeFileSync(file,new Uint8Array(await response.arrayBuffer()));}return decodePngBytes(fs.readFileSync(file));}));cases.push({variant:'managed',direction:direction.direction,images,durations:images.map(()=>1673/8),groupId:animation.animation_group_id});}
if(cases.length!==6)throw new Error('Expected three variants in both primary views.');
const variants=[...new Set(cases.map(c=>c.variant))].sort((a,b)=>createHash('sha256').update('workflow-body-review/'+a).digest('hex').localeCompare(createHash('sha256').update('workflow-body-review/'+b).digest('hex'))),key=Object.fromEntries(variants.map((name,i)=>[String.fromCharCode(65+i),name]));
const maxCell=Math.max(...cases.flatMap(c=>c.images.map((im:any)=>im.w)));if(cases.some(c=>c.images.some((im:any)=>im.w!==im.h||(maxCell-im.w)%2)))throw new Error('A constant symmetric native-pixel padding comparison is unavailable.');
const previews=[],metrics=[];
for(const c of cases){const label=Object.entries(key).find(([,name])=>name===c.variant)![0],stem=`blind-${label}-${c.direction}`,folder=path.join(out,stem);fs.mkdirSync(folder,{recursive:true});
  const normalized=c.images.map((im:any)=>padImg(im,(maxCell-im.w)/2));for(const [i,im]of c.images.entries())fs.writeFileSync(path.join(folder,`${i}.png`),await encodePngBytes(im));
  fs.writeFileSync(path.join(out,stem+'-large.png'),await encodePngBytes(contactSheet([normalized.slice(0,4),normalized.slice(4)],3,3)));
  const reference=await decodePngBytes(Buffer.from(fixture.references[c.direction].png,'base64'));
  metrics.push({label,variant:c.variant,direction:c.direction,jobId:c.jobId,groupId:c.groupId,requestHash:c.requestHash,frames:c.images.length,cell:[c.images[0].w,c.images[0].h],displayPadding:(maxCell-c.images[0].w)/2,borderPixels:c.images.map(borderPx),detachedPixels:c.images.map((im:any)=>bodyComponents(im).detachedPixels),paletteFit:paletteFit(reference,c.images),professionalQualification:false});
  previews.push({label,direction:c.direction,frames:await Promise.all(normalized.map(async(im:any)=>Buffer.from(await encodePngBytes(im)).toString('base64'))),durations:c.durations});
}
fs.writeFileSync(path.join(out,'body-blind-key.json'),JSON.stringify(key,null,2));fs.writeFileSync(path.join(out,'body-pixel-analysis.json'),JSON.stringify({version:1,billed:evidence.budget.calls.reduce((n:number,c:any)=>n+(c.billedUnits??0),0),cases:metrics,notes:['Only source-proxy versus native-depth isolates one geometry change. Managed differs in motion authoring and uses no exposed seed.','Constant symmetric padding is a display hypothesis, not an established managed pivot. No per-frame realignment is used.','Managed playback uses illustrative total duration1673ms, not timing supplied by PixelLab.','Pixel gates and palette similarity do not qualify naturalness, soles, grip or equipped occlusion.']},null,2));
const page=path.join(root,'app/test-results-workflow-body-review');fs.mkdirSync(page,{recursive:true});fs.writeFileSync(path.join(page,'index.html'),`<!doctype html><meta charset="utf-8"><title>Controlled body motion review</title><style>body{background:#18181c;color:#eee;font:16px system-ui;margin:24px}h1{font-size:24px}.clips{display:grid;grid-template-columns:repeat(3,minmax(200px,1fr));gap:20px}canvas{width:100%;max-width:336px;image-rendering:pixelated;background:#303038}p{max-width:1200px}article{min-width:0}</style><h1>Controlled same-artwork body review</h1><p>Three variants, south and east, eight frames each. Exact reference pixels verified. Blind labels hide the pipeline. This is research, not approved production animation.</p><p>Constant symmetric padding to ${maxCell}px; no per-frame alignment. Raw clips use authored timing. Managed timing is illustrative1673ms total. Padding does not establish a managed pivot.</p><div class="clips" id="clips"></div><script>const cases=${JSON.stringify(previews)};for(const dir of ['south','east'])for(const c of cases.filter(c=>c.direction===dir).sort((a,b)=>a.label.localeCompare(b.label))){const a=document.createElement('article');a.innerHTML='<h2>Candidate '+c.label+' / '+c.direction+'</h2>';const canvas=document.createElement('canvas');canvas.width=canvas.height=${maxCell};a.append(canvas);document.querySelector('#clips').append(a);const ctx=canvas.getContext('2d'),ims=c.frames.map(p=>{const im=new Image();im.src='data:image/png;base64,'+p;return im});let i=0;function tick(){ctx.clearRect(0,0,canvas.width,canvas.height);if(ims[i].complete)ctx.drawImage(ims[i],0,0);const ms=c.durations[i];i=(i+1)%ims.length;setTimeout(tick,ms)}tick()}</script>`);
console.log(JSON.stringify(metrics.map(({variant,direction,cell,borderPixels,detachedPixels})=>({variant,direction,cell,borderPixels,detachedPixels})),null,2));
