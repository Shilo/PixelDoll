	"notes": {
		"headline": "Share, export and keep more of your work",
		"intro": "This week brings quick ways to show off your character, more control over how you export, and a calmer way to get new characters and their moves started.",
		"highlights": [
			{
				"title": "Share a character preview quickly",
				"text": "You can now share a quick preview of your character, with simpler share controls that pack all facings. Scaled share exports and a PNG copy that sticks around are also new.",
				"commits": [
					"e95fb7e",
					"44b10d5",
					"3f0e570"
				]
			},
			{
				"title": "Export settings you control",
				"text": "Export settings are now saved across sessions, and each animation can have its own explicit export settings. A native GDevelop project export and a grouped export picker are also new.",
				"commits": [
					"1242daa",
					"63cf5be",
					"dc91766"
				]
			},
			{
				"title": "New characters start with Default",
				"text": "Creating a character now gives you a standing Default move first. You can then add idle and walk moves with Add idle + walk, and queued moves run one at a time.",
				"commits": [
					"46376ff"
				]
			},
			{
				"title": "Cleaner bodies and better-fitting items",
				"text": "New base bodies are now drawn bare, so torso items no longer show a gray shirt through them. Items can also hide the body pixels they cover, like ears under a hood.",
				"commits": [
					"87c72dd",
					"122ee79"
				]
			}
		],
		"fixes": [
			{
				"text": "Unsaved outfit edits now survive a quick reload or tab close.",
				"commits": [
					"7d81762"
				]
			},
			{
				"text": "Shared animations now loop continuously.",
				"commits": [
					"4b16455"
				]
			},
			{
				"text": "Phaser and Unity exports now keep your animation timing.",
				"commits": [
					"2e21f28",
					"6c3a47f"
				]
			}
		],
		"banner": "In a bright dye house courtyard, a tall courier with braided hair drapes a cobalt-and-orange striped scarf over a drying line, beside crates of folded outfits in golden afternoon light."
	}
